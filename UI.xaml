              <TextBlock Text="拖动滑杆即时预览玻璃浓度，步进为 1%；主题色在调色盘内拖动时同步刷新界面。" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,10,0,0"/>
            </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="21,11,18,15">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel x:Name="PendingDigits" Orientation="Horizontal" />
            <TextBlock Text=" 项待完成 · " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel x:Name="TotalDigits" Orientation="Horizontal" />
            <TextBlock Text=" 项日程" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
          <TextBlock Text="拖动边缘可调整大小" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
        </Grid>
      </Grid>
    </Border>
    <Border x:Name="SuccessToast" Visibility="Collapsed" IsHitTestVisible="False" Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35" CornerRadius="27" Background="{DynamicResource AccentBrush}" Panel.ZIndex="40">
      <Path x:Name="SuccessPath" Data="M 3,12 L 9,18 L 21,5" Width="25" Height="25" Stretch="Fill" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashArray="12,12" StrokeDashOffset="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
  </Grid>
</Window>
